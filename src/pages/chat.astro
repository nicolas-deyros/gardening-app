---
import Layout from "../layouts/Layout.astro";
import ChatInterface from "../components/ChatInterface";
---

<Layout title="AI Botanist Chat">
  <div class="max-w-4xl mx-auto">
    <h1
      class="text-4xl font-extrabold text-stone-800 mb-6 flex items-center gap-3"
    >
      <span class="text-5xl">🤖</span> Talk to the AI Botanist
    </h1>
    <p class="text-center text-stone-600 mb-8 max-w-2xl mx-auto">
      Ask about organic solutions, companion planting, or upload a photo to
      identify issues.
    </p>

    <ChatInterface client:load />
  </div>
</Layout>
