---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Garden Log">
  <div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1>Garden Log</h1>
      <button class="btn-primary"> + New Entry </button>
    </div>

    <div
      class="glass-panel p-10 text-center min-h-[400px] flex items-center justify-center flex-col"
    >
      <span class="text-6xl mb-4">📓🌱</span>
      <p class="text-xl text-stone-600">Garden Journal Coming Soon</p>
      <p class="text-stone-400 mt-2">
        Track your plantings, compost, and harvests here.
      </p>
    </div>
  </div>
</Layout>
