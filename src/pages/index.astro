---
import Layout from "../layouts/Layout.astro";
import GardenLens from "../components/GardenLens";
import LocalIntelligence from "../components/LocalIntelligence";

// Default to Buenos Aires (Manuel Alberti area approx) as per persona context
// Used only for context if needed, but primary logic moved to client
const DEFAULT_LAT = -34.42;
const DEFAULT_LON = -58.74;
---

<Layout title="Dashboard">
  <div class="space-y-8">
    <!-- Hero / Welcome -->
    <section class="text-center py-10">
      <h1 class="mb-4">Welcome back, Gardener.</h1>
      <p class="text-xl text-stone-600 max-w-2xl mx-auto mb-8">
        Your garden is currently <span class="font-bold text-green-700"
          >thriving</span
        >.
      </p>

      <!-- Visual Analysis CTA -->
      <div class="max-w-4xl mx-auto">
        <GardenLens client:load />
      </div>
    </section>

    <!-- Weather Logic Card -->
    <div class="grid md:grid-cols-2 gap-6">
      <LocalIntelligence client:load />

      <article class="glass-panel p-6 border-l-4 border-l-orange-400">
        <h2 class="text-lg font-bold text-stone-800 mb-4">Urgent Actions</h2>
        <ul class="space-y-3">
          <li class="flex items-center gap-3">
            <span
              class="w-6 h-6 rounded-full bg-stone-200 flex items-center justify-center text-xs"
              >1</span
            >
            <span class="text-stone-700">Check soil moisture (Finger Test)</span
            >
          </li>
          <li class="flex items-center gap-3">
            <span
              class="w-6 h-6 rounded-full bg-stone-200 flex items-center justify-center text-xs"
              >2</span
            >
            <span class="text-stone-700">Turn compost pile</span>
          </li>
        </ul>
        <div class="mt-6">
          <a href="/chat" class="btn-primary w-full">Ask AI Botanist</a>
        </div>
      </article>
    </div>
  </div>
</Layout>
